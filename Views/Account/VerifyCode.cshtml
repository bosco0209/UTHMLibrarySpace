@model VerifyCodeVm
@{
    ViewData["Title"] = "Verify your email";
}

<section class="auth-wrap">
    <div class="auth-side" style="background-image:url('https://images.unsplash.com/photo-1739918075668-fc7844c6d921?auto=format&fit=crop&w=1400&q=80')">
        <div class="auth-side-scrim"></div>
        <div class="auth-side-content">
            <div class="eyebrow text-warning">Almost there</div>
            <h1 class="font-display text-white display-5 mb-3">One more step.</h1>
            <p class="text-white-50">We sent a 6-digit code to <strong class="text-white">@Model.Email</strong>. It expires in 10 minutes.</p>
        </div>
    </div>
    <div class="auth-form-col">
        <div class="auth-card reveal">
            <h2 class="font-display mb-1">Verify your email</h2>
            <p class="text-secondary mb-4">Enter the 6-digit code we just emailed you.</p>
            <form asp-action="VerifyCode" method="post" data-testid="verify-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 small py-2" data-testid="verify-error"></div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label small fw-semibold">6-digit code</label>
                    <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                           class="form-control mono text-center"
                           style="font-size:1.6rem;letter-spacing:.4em;height:auto;padding:.75rem"
                           placeholder="••••••"
                           data-testid="verify-code-input" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <button class="btn btn-navy btn-lg w-100 rounded-pill mt-2" data-testid="verify-submit-button">
                    Verify &amp; create account
                </button>
            </form>
            <p class="text-center small text-secondary mt-4 mb-0">
                Wrong email? <a asp-action="Register" class="fw-semibold">Start again</a>
            </p>
        </div>
    </div>
</section>