@model ResetPasswordVm
@{
    ViewData["Title"] = "Reset password";
}
<section class="auth-wrap">
    <div class="auth-form-col">
        <div class="auth-card reveal">
            <h2 class="font-display mb-1">Set a new password</h2>
            <p class="text-secondary mb-4">Create a new password for <strong>@Model.Email</strong>.</p>
            <form asp-action="ResetPassword" method="post" data-testid="reset-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 small py-2"></div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold">New password</label>
                    <input asp-for="NewPassword" type="password" class="form-control form-control-lg" placeholder="••••••••" data-testid="reset-newpw" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="••••••••" data-testid="reset-confirmpw" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button class="btn btn-navy btn-lg w-100 rounded-pill" data-testid="reset-submit-button">Save new password</button>
            </form>
        </div>
    </div>
</section>
