@model VerifyCodeVm
@{
    ViewData["Title"] = "Verify your email";
}
<section class="auth-wrap">
    <div class="auth-form-col">
        <div class="auth-card reveal">
            <h2 class="font-display mb-1">Verify your email</h2>
            <p class="text-secondary mb-4">Enter the 6-digit code we sent to <strong>@Model.Email</strong>.</p>
            <form asp-action="ConfirmResetCode" method="post" data-testid="reset-verify-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 small py-2"></div>
                <div class="mb-3">
                    <label asp-for="Code" class="form-label small fw-semibold">6-digit code</label>
                    <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                           class="form-control mono text-center"
                           style="font-size:1.6rem;letter-spacing:.4em;height:auto;padding:.75rem"
                           placeholder="••••••"
                           data-testid="reset-code-input" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <button class="btn btn-navy btn-lg w-100 rounded-pill mt-2" data-testid="reset-verify-button">Verify</button>
            </form>
            <p class="text-center small text-secondary mt-4 mb-0"><a asp-action="ForgotPassword" class="fw-semibold">Resend code</a></p>
        </div>
    </div>
</section>
