@model ForgotPasswordVm
@{
    ViewData["Title"] = "Forgot password";
}
<section class="auth-wrap">
    <div class="auth-form-col">
        <div class="auth-card reveal">
            <h2 class="font-display mb-1">Forgot password</h2>
            <p class="text-secondary mb-4">Enter your email (or matric/staff ID) and we'll send you a 6-digit verification code.</p>
            <form asp-action="ForgotPassword" method="post" data-testid="forgot-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 small py-2"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold">Email or ID number</label>
                    <input asp-for="Email" class="form-control form-control-lg" placeholder="e.g. ai210045@siswa.uthm.edu.my" data-testid="forgot-email-input" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button class="btn btn-navy btn-lg w-100 rounded-pill" data-testid="forgot-submit-button">Send code <i class="bi bi-arrow-right ms-1"></i></button>
            </form>
            <p class="text-center small text-secondary mt-4 mb-0"><a asp-action="Login" class="fw-semibold">Back to sign in</a></p>
        </div>
    </div>
</section>
