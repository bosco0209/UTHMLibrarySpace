@model DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    var first = Model.User.Name.Replace("Dr. ", "Dr. ").Split(' ')[0] == "Dr." ? Model.User.Name : Model.User.Name.Split(' ')[0];
    var hour = AppClock.Now.Hour;
    var greet = hour < 12 ? "Selamat pagi" : hour < 19 ? "Selamat petang" : "Selamat malam";
}
<section class="page-head">
    <div class="container-xl d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <div class="eyebrow">@greet 👋</div>
            <h1 class="page-title" data-testid="dashboard-greeting">Hi, @first</h1>
            <p class="text-secondary mb-0">
                <span class="role-tag role-@Model.User.Role.ToLower()">@Model.User.Role</span>
                <span class="mono ms-1">@Model.User.IdNumber</span> · @Model.User.Faculty
            </p>
        </div>
        <a asp-controller="Facilities" asp-action="Index"
           class="btn btn-gold rounded-pill px-4"
           data-testid="dashboard-new-booking-button">
            <i class="bi bi-plus-lg me-1"></i>New booking
        </a>
    </div>
</section>

<section class="container-xl pb-5">
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-calendar2-check"></i>
                <span class="mono" data-testid="dashboard-stat-total">@Model.TotalBookings</span>
                <small>Total bookings</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-calendar-event"></i>
                <span class="mono" data-testid="dashboard-stat-upcoming">@Model.Upcoming.Count</span>
                <small>Upcoming</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <i class="bi bi-hourglass-split"></i>
                <span class="mono" data-testid="dashboard-stat-pending">@Model.PendingCount</span>
                <small>Awaiting approval</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card stat-gold">
                <i class="bi bi-wallet2"></i>
                <span class="mono" data-testid="dashboard-stat-fees">RM @Model.OutstandingFees.ToString("0.00")</span>
                <small>Payment due</small>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel h-100" data-testid="dashboard-upcoming">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h5 mb-0">Upcoming bookings</h3>
                    <a asp-controller="Bookings" asp-action="Index"
                       class="small fw-semibold"
                       data-testid="dashboard-view-all-bookings">View all</a>
                </div>
                @if (!Model.Upcoming.Any())
                {
                    <div class="empty-state py-4">
                        <span class="empty-icon"><i class="bi bi-calendar-plus"></i></span>
                        <p class="text-secondary">No upcoming bookings yet.</p>
                        <a asp-controller="Facilities" asp-action="Index" class="btn btn-navy rounded-pill">Find a space</a>
                    </div>
                }
                @foreach (var b in Model.Upcoming)
                {
                    <div class="booking-row" data-testid="dashboard-booking-@b.Reference">
                        <div class="date-tile">
                            <span>@b.Date.ToString("MMM")</span>
                            <strong>@b.Date.Day</strong>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold text-truncate">@b.Facility!.Name</div>
                            <div class="small text-secondary">
                                <span class="mono">@(b.IsRental ? "Until " + b.EndDate.ToString("dd MMM") + " · 1 month" : b.TimeText)</span> · @b.Purpose
                            </div>
                        </div>
                        <div class="text-end">
                            <partial name="_StatusBadge" model="b.Status" />
                            @if (b.AwaitingProof)
                            {
                                <a asp-controller="Bookings" asp-action="Proof" asp-route-id="@b.Id"
                                   class="d-block small text-warning-emphasis mt-1"
                                   data-testid="dashboard-upload-proof-@b.Reference">Upload proof</a>
                            }
                            else if (b.PaymentStatus == PaymentStatus.ProofSubmitted)
                            {
                                <div class="small text-secondary mt-1">Proof under review</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel h-100" data-testid="dashboard-notifications">
                <h3 class="h5 mb-3">Notifications</h3>
                @if (!Model.Notifications.Any())
                {
                    <p class="small text-secondary">Nothing new.</p>
                }
                @foreach (var n in Model.Notifications)
                {
                    <div class="notif-item rounded-3 mb-2 @(n.IsRead ? "" : "unread")">
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold small">@n.Title</span>
                            <span class="text-secondary" style="font-size:.7rem">@Ui.Ago(n.CreatedAt)</span>
                        </div>
                        <div class="small text-secondary">@n.Message</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-end mt-5 mb-3">
        <div>
            <div class="eyebrow">Live availability</div>
            <h3 class="h4 mb-0">Spaces you can book</h3>
        </div>
    </div>
    <div class="row g-4">
        @foreach (var c in Model.Bookable)
        {
            <div class="col-md-6 col-xl-4">
                <partial name="_FacilityCard" model="c" />
            </div>
        }
    </div>
</section>