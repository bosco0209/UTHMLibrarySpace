@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirstValue(ClaimTypes.Role);
    // Admins promoted from a student/lecturer keep booking, so they get the personal pages too.
    var bookingRole = User.CurrentBookingRole();
    var canBook = isAuth && bookingRole is Roles.Student or Roles.Lecturer;
    var name = User.Identity?.Name ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => controller == c ? "active" : "";
    var fullBleed = ViewData["FullBleed"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")UTHM Library Space</title>
    <meta name="description" content="UTHM Library Space — book study rooms, meeting rooms, tutorial rooms, halls and technology rooms at Perpustakaan Tunku Tun Aminah online, 24/7." />
    <link rel="icon" type="image/png" href="~/img/uthm-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(fullBleed ? "full-bleed" : "")">
    @await Component.InvokeAsync("AnnouncementBanner")

    <nav class="navbar navbar-expand-lg app-nav sticky-top" data-testid="main-navbar">
        <div class="container-xl">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index" data-testid="nav-brand-link">
                <img src="~/img/uthm-logo.png" alt="UTHM" class="brand-logo" />
                <span class="d-flex flex-column lh-1">
                    <span class="brand-title">Library Space</span>
                    <span class="brand-sub">PTTA · UTHM</span>
                </span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation" data-testid="nav-toggle-button">
                <i class="bi bi-list fs-3"></i>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto ms-lg-4 gap-lg-1">
                    <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index" data-testid="nav-home-link">Home</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Facilities")" asp-controller="Facilities" asp-action="Index" data-testid="nav-facilities-link">Facilities</a></li>
                    @if (canBook)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index" data-testid="nav-dashboard-link">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Bookings")" asp-controller="Bookings" asp-action="Index" data-testid="nav-my-bookings-link">My Bookings</a></li>
                    }
                    @if (role == Roles.Admin)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Admin")" asp-controller="Admin" asp-action="Index" data-testid="nav-admin-link"><i class="bi bi-shield-lock me-1"></i>Admin Console</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    @if (isAuth)
                    {
                        @await Component.InvokeAsync("NotificationBell")
                        <div class="dropdown">
                            <button class="btn user-chip dropdown-toggle" data-bs-toggle="dropdown" data-testid="nav-user-menu-button">
                                @{
                                    var avatarUrl = User.FindFirstValue("Avatar");
                                }
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img src="@avatarUrl" alt="" class="avatar avatar-img" data-testid="nav-user-avatar-img" />
                                }
                                else
                                {
                                    <span class="avatar">@Ui.Initials(name)</span>
                                }
                                <span class="d-none d-md-flex flex-column text-start lh-sm">
                                    <span class="fw-semibold small" data-testid="nav-user-name">@name</span>
                                    <span class="role-tag role-@role?.ToLower()" data-testid="nav-user-role">@role</span>
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2">
                                <li class="px-3 py-2 small text-secondary"><span class="mono">@User.FindFirstValue("IdNumber")</span></li>
                                @if (role == Roles.Admin && bookingRole != Roles.Admin)
                                {
                                    <li class="px-3 py-1 small text-secondary">
                                        <i class="bi bi-shield-check me-1"></i>Also books as <strong>@bookingRole</strong>
                                    </li>
                                }
                                @if (role == Roles.Admin)
                                {
                                    <li><a class="dropdown-item rounded-3" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Console</a></li>
                                }
                                @if (canBook)
                                {
                                    <li><a class="dropdown-item rounded-3" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item rounded-3" asp-controller="Bookings" asp-action="Index"><i class="bi bi-calendar-check me-2"></i>My Bookings</a></li>
                                }
                                <li><a class="dropdown-item rounded-3" asp-controller="Account" asp-action="Profile" data-testid="nav-profile-link"><i class="bi bi-person-gear me-2"></i>My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item rounded-3" asp-controller="Feedback" asp-action="Index" data-testid="nav-feedback-link">
                                        <i class="bi bi-chat-left-text me-2"></i>Feedback
                                    </a>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item rounded-3 text-danger" type="submit" data-testid="nav-logout-button"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-ghost" asp-controller="Account" asp-action="Login" data-testid="nav-login-button">Sign in</a>
                        <a class="btn btn-gold" asp-controller="Account" asp-action="Register" data-testid="nav-register-button">Create account</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container-xl">
            <div class="row g-4 align-items-start">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/img/uthm-logo-footer.png" alt="UTHM" class="brand-logo brand-logo-light" style="background:#fff; border-radius:8px; padding:4px;" />
                        <span class="brand-title text-white">UTHM Library Space</span>
                    </div>
                    <p class="text-white-50 small mb-0">The official facility booking platform of Perpustakaan Tunku Tun Aminah, Universiti Tun Hussein Onn Malaysia. Real-time availability, instant confirmations and 24/7 AI assistance.</p>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="eyebrow text-white-50 mb-2">Library hours</div>
                    <p class="small text-white-75 mb-1">Bookable daily · <span class="mono">08:00 – 22:00</span></p>
                    <p class="small text-white-75 mb-0">Counter: Level 1, Main Block</p>
                </div>
                <div class="col-6 col-lg-4">
                    <div class="eyebrow text-white-50 mb-2">Contact</div>
                    <p class="small text-white-75 mb-1"><i class="bi bi-telephone me-2"></i>07-453 3333</p>
                    <p class="small text-white-75 mb-0"><i class="bi bi-envelope me-2"></i>ptta@uthm.edu.my</p>
                </div>
            </div>
            <div class="footer-bottom">© @DateTime.UtcNow.Year Perpustakaan Tunku Tun Aminah, UTHM · PSM project by Chie Wai Lun (AI240119)</div>
        </div>
    </footer>

    <partial name="_ChatWidget" />

    <div class="toast-container position-fixed bottom-0 end-0 p-3 toast-stack">
        @if (TempData["ToastMessage"] is string toast)
        {
            var kind = TempData["ToastKind"] as string ?? "success";
            <div class="toast app-toast toast-@kind show" role="alert" data-bs-delay="5000" data-testid="app-toast">
                <div class="d-flex align-items-start gap-2 p-3">
                    <i class="bi @(kind == "danger" ? "bi-exclamation-circle-fill" : kind == "warning" ? "bi-exclamation-triangle-fill" : kind == "info" ? "bi-info-circle-fill" : "bi-check-circle-fill") fs-5"></i>
                    <div class="flex-grow-1 small fw-medium" data-testid="app-toast-message">@toast</div>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>