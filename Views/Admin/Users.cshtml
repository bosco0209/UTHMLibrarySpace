@using System.Security.Claims
@model List<User>
@{
    ViewData["Title"] = "Users";
    var counts = ViewBag.BookingCounts as Dictionary<int, int> ?? new();
    var me = User.CurrentUserId();
}
<section class="page-head admin-head">
    <div class="container-xl">
        <div class="eyebrow text-warning">PTTA command center</div>
        <h1 class="page-title text-white">User management</h1>
    </div>
</section>
<section class="container-xl pb-5 admin-body">
    <partial name="_AdminNav" />

    <form method="get" class="panel d-flex flex-wrap gap-2 mb-4" data-testid="admin-users-filter-form">
        <select name="role" class="form-select" style="max-width:180px" data-testid="admin-users-role-filter">
            <option value="">All roles</option>
            @foreach (var r in new[] { Roles.Student, Roles.Lecturer, Roles.Admin })
            {
                <option value="@r" selected="@(ViewBag.Role == r)">@r</option>
            }
        </select>
        <div class="input-icon flex-grow-1">
            <i class="bi bi-search"></i>
            <input name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Name, email, matric / staff ID"
                   data-testid="admin-users-search-input" />
        </div>
        <button class="btn btn-navy rounded-pill px-4" data-testid="admin-users-filter-button">Filter</button>
    </form>

    <div class="panel mb-4 admin-add-admin" data-testid="admin-add-admin-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <div class="fw-bold"><i class="bi bi-shield-plus me-1"></i>Add another admin</div>
                <div class="small text-secondary">
                    Enter an email only. If the address already belongs to a student or lecturer, that account is
                    promoted to Admin and keeps its current password — and keeps booking rooms under the role it was
                    promoted from. Otherwise a new admin account is created and a temporary password is emailed to
                    the address.
                </div>
            </div>
            <span class="pill pill-pending align-self-start">
                <i class="bi bi-circle-fill"></i>@(Model.Count(u => u.Role == Roles.Admin)) admin@(Model.Count(u => u.Role == Roles.Admin) == 1 ? "" : "s") now
            </span>
        </div>
        <form asp-action="AddAdmin" method="post" class="d-flex flex-wrap gap-2"
              data-testid="admin-add-admin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <div class="input-icon flex-grow-1" style="min-width:260px">
                <i class="bi bi-envelope"></i>
                <input type="email" name="email" class="form-control" required
                       placeholder="new.admin@uthm.edu.my"
                       data-testid="admin-add-admin-email" />
            </div>
            <button class="btn btn-navy rounded-pill px-4" data-testid="admin-add-admin-submit">
                <i class="bi bi-shield-lock me-1"></i>Grant admin access
            </button>
        </form>
    </div>

    <div class="panel p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table app-table align-middle mb-0" data-testid="admin-users-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>ID</th>
                        <th>Role</th>
                        <th>Faculty</th>
                        <th>Bookings</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var bookingCount = counts.GetValueOrDefault(u.Id);
                        var hasBookings = bookingCount > 0;
                        var confirmMsg = hasBookings
                            ? $"Delete {u.Name} and all their bookings permanently? This cannot be undone."
                            : $"Delete {u.Name} permanently? This cannot be undone.";

                        <tr data-testid="admin-user-row-@u.IdNumber.ToLower()">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar">@Ui.Initials(u.Name)</span>
                                    <div>
                                        <div class="fw-semibold small">@u.Name</div>
                                        <div class="small text-secondary">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="mono small">@u.IdNumber</td>
                            <td>
                                <span class="role-tag role-@u.Role.ToLower()">@u.Role</span>
                                @if (u.Role == Roles.Admin && u.BookingRole is Roles.Student or Roles.Lecturer)
                                {
                                    <span class="pill pill-pending ms-1" title="Kept booking permissions from the role this admin was promoted from">
                                        <i class="bi bi-calendar-check"></i>books as @u.BookingRole
                                    </span>
                                }
                            </td>
                            <td class="small">@u.Faculty</td>
                            <td class="mono small">@bookingCount</td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="pill pill-confirmed"><i class="bi bi-circle-fill"></i>Active</span>
                                }
                                else
                                {
                                    <span class="pill pill-rejected"><i class="bi bi-slash-circle"></i>Disabled</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (u.Id != me)
                                {
                                    @if (u.Role != Roles.Admin)
                                    {
                                        <form asp-action="AddAdmin" method="post" class="d-inline"
                                              onsubmit="return confirm('Grant Admin access to @u.Email? They will be able to manage every booking, user and room.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="email" value="@u.Email" />
                                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                            <button class="btn btn-sm btn-outline-navy rounded-pill px-3"
                                                    title="Promote @u.Email to Admin"
                                                    data-testid="admin-make-admin-@u.IdNumber.ToLower()">
                                                <i class="bi bi-shield-plus"></i>Make admin
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="ToggleUser" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                        <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3"
                                                data-testid="admin-toggle-user-@u.IdNumber.ToLower()">
                                            @(u.IsActive ? "Disable" : "Activate")
                                        </button>
                                    </form>
                                    <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('@confirmMsg');">
                                        @Html.AntiForgeryToken()
                                        @if (hasBookings)
                                        {
                                            <input type="hidden" name="force" value="true" />
                                        }
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                title="@(hasBookings ? $"Delete {u.Name} and their {bookingCount} booking(s)" : $"Delete {u.Name}")"
                                                data-testid="admin-delete-user-@u.IdNumber.ToLower()">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="small text-secondary">You</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>